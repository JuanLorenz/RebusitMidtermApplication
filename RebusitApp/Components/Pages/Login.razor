@page "/"
@page "/login"
@using RebusitApp.Data
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<div class="min-h-screen bg-[#050907] flex flex-col lg:flex-row text-zinc-100 font-sans selection:bg-red-600 selection:text-white">
    
    <!-- Left Column: Vertically Centered Form Panel -->
    <div class="w-full lg:w-5/12 bg-[#0B1310] p-8 lg:p-14 flex flex-col justify-center border-r border-zinc-800 shadow-[0_0_50px_rgba(0,0,0,0.8)] z-10">
        <div>
            <!-- Entertainment Branding Header -->
            <div class="flex items-center space-x-3 mb-10">
                <div class="w-12 h-12 bg-gradient-to-br from-red-600 to-red-800 rounded-xl flex items-center justify-center font-black text-amber-400 text-2xl shadow-lg border border-red-500/30">
                    ⚡
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h1 class="text-2xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Sabong Prime</h1>
                        <span class="text-[9px] bg-red-600/30 text-red-400 border border-red-500/40 px-1.5 py-0.5 rounded font-black tracking-widest uppercase">PRO</span>
                    </div>
                    <p class="text-[11px] text-zinc-400 font-medium tracking-wider">ENTERTAINMENT & LIVE SPORTS NETWORK</p>
                </div>
            </div>

            <div class="mb-8">
                <h2 class="text-2xl font-black text-white uppercase tracking-wide">Enter Arena</h2>
                <p class="text-xs text-zinc-400 mt-1">Sign in to place real-time bets and stream live championship fights.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 bg-red-950/80 border border-red-800 text-red-200 text-xs rounded-xl font-medium flex items-center space-x-2">
                    <span class="text-base">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- Form -->
            <form @onsubmit="HandleLogin" class="space-y-6">
                <div>
                    <label class="block text-[11px] font-black text-amber-400 uppercase tracking-widest mb-2">Username</label>
                    <input type="text" @bind="username" required 
                           class="w-full px-4 py-3.5 bg-[#050907] border border-zinc-800 rounded-xl text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400/80 focus:ring-1 focus:ring-amber-400/50 transition duration-200 text-sm font-medium" 
                           placeholder="Username or Member ID" />
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-[11px] font-black text-amber-400 uppercase tracking-widest">Password</label>
                    </div>
                    <input type="password" @bind="password" required 
                           class="w-full px-4 py-3.5 bg-[#050907] border border-zinc-800 rounded-xl text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400/80 focus:ring-1 focus:ring-amber-400/50 transition duration-200 text-sm font-medium" 
                           placeholder="••••••••••••" />
                </div>

                <button type="submit" 
                        class="w-full py-4 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 text-white font-black uppercase tracking-widest text-sm rounded-xl shadow-[0_0_20px_rgba(220,38,38,0.4)] transition duration-200 active:scale-[0.98]">
                    Login ➔
                </button>
            </form>

            <!-- Footer link -->
            <div class="mt-10 pt-6 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-400">
                <span>New to the network?</span>
                <a href="/register" class="text-amber-400 font-bold hover:text-amber-300 uppercase tracking-wider underline transition">Create Member Account</a>
            </div>
        </div>
    </div>

    <!-- Right Column: Broadcast Backstage View -->
    <div class="w-full lg:w-7/12 p-8 lg:p-14 relative flex flex-col justify-between overflow-hidden bg-[#050907]">
        
        <!-- Background Banner -->
        <img src="/bg-login.jpg" alt="Arena Spotlight" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none filter brightness-75 contrast-125" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#050907] via-[#050907]/60 to-transparent pointer-events-none"></div>

        <!-- Top Live Broadcast Ticker -->
        <div class="relative z-10 flex justify-between items-center bg-[#0B1310]/90 backdrop-blur-md px-5 py-3 rounded-2xl border border-zinc-800">
            <div class="flex items-center space-x-3">
                <span class="flex h-3 w-3 relative">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-red-600"></span>
                </span>
                <span class="text-xs font-black uppercase tracking-widest text-white">TONIGHT'S MAIN EVENT</span>
            </div>
            <span class="text-[11px] font-mono text-amber-400 bg-amber-500/10 border border-amber-500/20 px-3 py-1 rounded-full uppercase">Derby Prize: ₱5,000,000</span>
        </div>

        <!-- Broadcast Arenas Grid -->
        <div class="max-w-2xl mx-auto w-full relative z-10 my-auto py-8">
            <div class="mb-6 flex justify-between items-end border-b border-zinc-800 pb-3">
                <div>
                    <span class="text-[10px] font-extrabold text-red-500 uppercase tracking-widest">Featured Stage Feed</span>
                    <h2 class="text-2xl font-black text-amber-400 uppercase tracking-wide">Live Arenas</h2>
                </div>
                <span class="text-xs text-zinc-400 font-mono">2 / 2 ACTIVE PITS</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Arena 1 -->
                <div class="group bg-[#0B1310] border border-zinc-800 hover:border-amber-400/50 rounded-2xl overflow-hidden shadow-2xl transition duration-300">
                    <div class="h-44 bg-zinc-900 relative overflow-hidden">
                        <img src="/luzon-arena.jpg" alt="Luzon Arena" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                        <div class="absolute top-3 right-3 bg-red-600 text-white text-[9px] font-black px-2.5 py-1 rounded-md uppercase tracking-widest shadow">LIVE BROADCAST</div>
                    </div>
                    <div class="p-4 bg-[#0B1310]">
                        <h3 class="font-black text-amber-400 text-base group-hover:text-amber-300 transition">Luzon Championship Dome</h3>
                        <p class="text-xs text-zinc-400 mt-1">Match #48 • Heavyweight Cockfight Derby</p>
                    </div>
                </div>

                <!-- Arena 2 -->
                <div class="group bg-[#0B1310] border border-zinc-800 hover:border-amber-400/50 rounded-2xl overflow-hidden shadow-2xl transition duration-300">
                    <div class="h-44 bg-zinc-900 relative overflow-hidden">
                        <img src="/visayas-arena.jpg" alt="Visayas Arena" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                        <div class="absolute top-3 right-3 bg-amber-500 text-zinc-950 text-[9px] font-black px-2.5 py-1 rounded-md uppercase tracking-widest shadow">FEATURED</div>
                    </div>
                    <div class="p-4 bg-[#0B1310]">
                        <h3 class="font-black text-amber-400 text-base group-hover:text-amber-300 transition">Visayas Grand Coliseum</h3>
                        <p class="text-xs text-zinc-400 mt-1">Match #12 • High Stakes Invitational</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="relative z-10 text-center text-[11px] text-zinc-500 tracking-wider uppercase font-mono">
            Encrypted Stream Network • 4K Ultra-Low Latency
        </div>
    </div>

</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        var user = DbContext.Users.FirstOrDefault(u => u.Username == username && u.Password == password);

        if (user != null)
        {
            Navigation.NavigateTo("/dashboard");
        }
        else
        {
            errorMessage = "Invalid credentials. Please verify your handle and password.";
        }
    }
}
@page "/register"
@using RebusitApp.Data
@using RebusitApp.Models
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<div class="min-h-screen bg-[#050907] flex flex-col lg:flex-row text-zinc-100 font-sans selection:bg-amber-500 selection:text-zinc-950">
    
    <!-- Left Column: Vertically Centered Form Panel -->
    <div class="w-full lg:w-5/12 bg-[#0B1310] p-8 lg:p-14 flex flex-col justify-center border-r border-zinc-800 shadow-[0_0_50px_rgba(0,0,0,0.8)] z-10">
        <div>
            <!-- Header -->
            <div class="flex items-center space-x-3 mb-10">
                <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-amber-700 rounded-xl flex items-center justify-center font-black text-zinc-950 text-2xl shadow-lg border border-amber-400/30">
                    ★
                </div>
                <div>
                    <h1 class="text-2xl font-black uppercase tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">VIP Pass</h1>
                    <p class="text-[11px] text-zinc-400 font-medium tracking-wider">REGISTER COMPETITOR ACCOUNT</p>
                </div>
            </div>

            <div class="mb-8">
                <h2 class="text-2xl font-black text-white uppercase tracking-wide">Claim Pass</h2>
                <p class="text-xs text-zinc-400 mt-1">Create a verified account to place bets and access live streams.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 bg-red-950/80 border border-red-800 text-red-200 text-xs rounded-xl font-medium flex items-center space-x-2">
                    <span class="text-base">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- Form -->
            <form @onsubmit="HandleRegister" class="space-y-6">
                <div>
                    <label class="block text-[11px] font-black text-amber-400 uppercase tracking-widest mb-2">Choose Handle</label>
                    <input type="text" @bind="username" required 
                           class="w-full px-4 py-3.5 bg-[#050907] border border-zinc-800 rounded-xl text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400/80 focus:ring-1 focus:ring-amber-400/50 transition duration-200 text-sm font-medium" 
                           placeholder="e.g. MasterBettor99" />
                </div>

                <div>
                    <label class="block text-[11px] font-black text-amber-400 uppercase tracking-widest mb-2">Secure Passcode</label>
                    <input type="password" @bind="password" required 
                           class="w-full px-4 py-3.5 bg-[#050907] border border-zinc-800 rounded-xl text-white placeholder-zinc-600 focus:outline-none focus:border-amber-400/80 focus:ring-1 focus:ring-amber-400/50 transition duration-200 text-sm font-medium" 
                           placeholder="Minimum 6 characters" />
                </div>

                <button type="submit" 
                        class="w-full py-4 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-zinc-950 font-black uppercase tracking-widest text-sm rounded-xl shadow-[0_0_20px_rgba(245,158,11,0.3)] transition duration-200 active:scale-[0.98]">
                    Complete Registration ➔
                </button>
            </form>

            <!-- Footer link -->
            <div class="mt-10 pt-6 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-400">
                <span>Already registered?</span>
                <a href="/login" class="text-amber-400 font-bold hover:text-amber-300 uppercase tracking-wider underline transition">Sign In Here</a>
            </div>
        </div>
    </div>

    <!-- Right Column: Register Spotlight Background -->
    <div class="w-full lg:w-7/12 p-8 lg:p-14 relative flex flex-col justify-between overflow-hidden bg-[#050907]">
        <img src="/bg-register.jpg" alt="Register Background" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none filter brightness-75 contrast-125" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#050907] via-[#050907]/60 to-transparent pointer-events-none"></div>

        <div class="relative z-10 flex justify-between items-center bg-[#0B1310]/90 backdrop-blur-md px-5 py-3 rounded-2xl border border-zinc-800">
            <span class="text-xs font-black uppercase tracking-widest text-white">MEMBER BENEFITS</span>
            <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full uppercase">INSTANT 24/7 CASHOUTS</span>
        </div>

        <div class="max-w-2xl mx-auto w-full relative z-10 my-auto py-8">
            <div class="mb-6 flex justify-between items-end border-b border-zinc-800 pb-3">
                <div>
                    <span class="text-[10px] font-extrabold text-amber-500 uppercase tracking-widest">Network Coverage</span>
                    <h2 class="text-2xl font-black text-amber-400 uppercase tracking-wide">Official Arenas</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Arena 1 -->
                <div class="group bg-[#0B1310] border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl">
                    <div class="h-44 bg-zinc-900 relative overflow-hidden">
                        <img src="/luzon-arena.jpg" alt="Luzon Arena" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                    </div>
                    <div class="p-4 bg-[#0B1310]">
                        <h3 class="font-black text-amber-400 text-base">Luzon Arena Pit</h3>
                        <p class="text-xs text-zinc-400 mt-1">National Derby Stage</p>
                    </div>
                </div>

                <!-- Arena 2 -->
                <div class="group bg-[#0B1310] border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl">
                    <div class="h-44 bg-zinc-900 relative overflow-hidden">
                        <img src="/visayas-arena.jpg" alt="Visayas Arena" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                    </div>
                    <div class="p-4 bg-[#0B1310]">
                        <h3 class="font-black text-amber-400 text-base">Visayas Sports Center</h3>
                        <p class="text-xs text-zinc-400 mt-1">Regional Championship Pit</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="relative z-10 text-center text-[11px] text-zinc-500 tracking-wider uppercase font-mono">
            Sabong Prime Network • Certified Live Gaming
        </div>
    </div>

</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        if (DbContext.Users.Any(u => u.Username == username))
        {
            errorMessage = "Handle is already taken. Please choose another.";
            return;
        }

        var newUser = new User { Username = username, Password = password };
        DbContext.Users.Add(newUser);
        await DbContext.SaveChangesAsync();

        Navigation.NavigateTo("/login");
    }
}